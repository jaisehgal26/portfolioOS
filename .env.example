# portfolioOS — shared local env (frontend + backend)
# Copy to .env at repo root:  cp .env.example .env

# --- Frontend (Next.js) ---
# Production (Vercel): leave unset — contact API is same-origin /api/v1/contact
NEXT_PUBLIC_API_URL=http://localhost:8000
# Cloudflare Turnstile site key (public) — pair with TURNSTILE_SECRET_KEY on backend
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: ipinfo.io token for Speed Test ISP lookup — https://ipinfo.io/signup (50k req/mo free)
IPINFO_TOKEN=5a1f269fca18b7

# --- Backend (FastAPI) — local Docker Postgres (pnpm docker:up) ---
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@127.0.0.1:5433/portfolio
CORS_ORIGINS=http://localhost:3000

# --- Resend (contact form emails) — https://resend.com/api-keys ---
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=JaiOS <onboarding@resend.dev>
NOTIFY_EMAIL=sehgaljai81@gmail.com

# --- Upstash Redis (rate limiting) — can reuse QuickPad database ---
# portfolioOS keys: rl:{scope}:{ip_hash} — safe alongside QuickPad
# URL must include https:// (e.g. https://solid-gnat-185175.upstash.io)
UPSTASH_REDIS_REST_URL=https://solid-gnat-185175.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# --- Cron (external scheduler: cron-job.org, etc.) ---
# GET /api/v1/health/cron with Authorization: Bearer <secret> OR ?secret=<secret>
CRON_SECRET=generate-a-long-random-string

# --- Admin portal (/admin) — username/password login for the admin center UI ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
# Optional: legacy API key for curl/scripts (X-Admin-Key header)
ADMIN_API_KEY=generate-a-long-random-string

# --- Reactions visitor fingerprint salt ---
REACTION_HASH_SALT=change-me-in-production

# --- Cloudflare Turnstile (spam / bot protection on public write endpoints) ---
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Frontend: NEXT_PUBLIC_TURNSTILE_SITE_KEY (same value in Vercel dashboard)
TURNSTILE_SECRET_KEY=

# --- Production (Vercel dashboard only — not this file) ---
