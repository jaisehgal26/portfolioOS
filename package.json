{
  "name": "portfolio-os",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "node scripts/dev-frontend.mjs",
    "dev:backend": "node scripts/dev-backend.mjs",
    "setup:frontend": "node scripts/ensure-frontend-deps.mjs",
    "setup:backend": "node scripts/ensure-backend-venv.mjs",
    "build": "cd frontend && pnpm build",
    "lint": "pnpm --filter frontend lint",
    "typecheck": "pnpm --filter frontend typecheck",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "next": "^15.3.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
